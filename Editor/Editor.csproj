<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <HotReloadEnabled>true</HotReloadEnabled>
        <HotReloadPartialTypes>true</HotReloadPartialTypes>
        <IsPackable>false</IsPackable>
        <LangVersion>14</LangVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <AssemblyName>Editor</AssemblyName>
        <PublishSingleFile>true</PublishSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <SelfContained>true</SelfContained>
    </PropertyGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\Engine\Engine.csproj" />
    </ItemGroup>

    <Target Name="BuildContentProject" BeforeTargets="Build">
        <MSBuild Projects="..\..\Game\Content\Content.csproj" Targets="Restore;Build" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier)" />
        <MSBuild Projects="..\..\Game\Editor\Content.Editor.csproj" Targets="Restore;Build" Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier)" />
    </Target>

    <ItemGroup>
      <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    </ItemGroup>

    <ItemGroup>
        <None Update="button.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Assets\" />
    </ItemGroup>

    <Target Name="CopyProjectConfigToBuildDir" AfterTargets="Build">
        <PropertyGroup>
            <ProjectConfigBuildDir>$(MSBuildThisFileDirectory)..\..\Build\$(Configuration)\$(TargetFramework)\</ProjectConfigBuildDir>
        </PropertyGroup>
        <ItemGroup>
            <ProjectConfigFile Include="..\..\Game\ProjectConfig.json" />
        </ItemGroup>
        <MakeDir Directories="$(ProjectConfigBuildDir)" Condition="Exists('..\..\Game\ProjectConfig.json')" />
        <Copy SourceFiles="@(ProjectConfigFile)"
              DestinationFolder="$(ProjectConfigBuildDir)"
              SkipUnchangedFiles="true"
              Condition="Exists('%(ProjectConfigFile.FullPath)')" />
    </Target>
</Project>
